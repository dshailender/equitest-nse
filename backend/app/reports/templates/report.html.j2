<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Backtest Report — {{ run_id }}</title>
    <style>
        {{ stylesheet_content | safe }}
    </style>
</head>
<body>

<!-- SECTION 1: COVER PAGE -->
<div class="cover-page page-break">
    <div class="cover-header">
        {% if logo_uri %}
        <img src="{{ logo_uri }}" alt="Logo" class="cover-logo" />
        {% elif branding.logo_path %}
        <img src="{{ branding.logo_path }}" alt="Logo" class="cover-logo" />
        {% endif %}
        <div class="cover-firm-name">{{ branding.firm_name }}</div>
        <h1 class="cover-title">Backtest Report — {{ strategy_name }}</h1>
        <div class="cover-subtitle">Quantitative Strategy Performance Verification &amp; Trade Ledger</div>

        <div class="cover-meta-grid">
            <div class="cover-meta-item">
                <span class="cover-meta-label">Run Identification</span>
                <span class="cover-meta-value mono">{{ run_id }}</span>
            </div>
            <div class="cover-meta-item">
                <span class="cover-meta-label">Generation Date</span>
                <span class="cover-meta-value">{{ generation_date if generation_date else "Deterministic Run" }}</span>
            </div>
            <div class="cover-meta-item">
                <span class="cover-meta-label">Backtest Period</span>
                <span class="cover-meta-value">{{ start_date }} – {{ end_date }}</span>
            </div>
            <div class="cover-meta-item">
                <span class="cover-meta-label">Universe Traded</span>
                <span class="cover-meta-value">{{ symbol_count }} symbols (NSE 101–750)</span>
            </div>
        </div>
    </div>

    <div class="cover-disclaimer">
        <strong>Confidential &amp; Proprietary:</strong> {{ branding.disclaimer_text }}
    </div>
</div>

<!-- SECTION 2: EXECUTIVE SUMMARY -->
<div class="page-break">
    <div class="section-header">
        <h2 class="section-title">Executive Summary</h2>
        <span class="section-subtitle">Core Performance Metrics &amp; Strategy Synthesis</span>
    </div>

    <div class="narrative-box">
        Over the {{ narrative.years }}-year period, the strategy took {{ narrative.trades }} trades, achieved a win rate of {{ narrative.win_rate }}%, and grew capital from {{ narrative.start_cap }} to {{ narrative.end_cap }}, a CAGR of {{ narrative.cagr }}%.
    </div>

    <!-- Core KPI Cards -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">Final Capital</div>
            <div class="kpi-value {{ 'profit' if metrics.final_capital >= metrics.initial_capital else 'loss' }}">
                ₹{{ "{:,.2f}".format(metrics.final_capital) }}
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Total Return %</div>
            <div class="kpi-value {{ 'profit' if metrics.total_return_pct >= 0 else 'loss' }}">
                {{ "{:+.2f}%".format(metrics.total_return_pct * 100) }}
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Number of Trades</div>
            <div class="kpi-value">{{ metrics.total_trades }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Average Profit</div>
            <div class="kpi-value profit">₹{{ "{:,.2f}".format(metrics.avg_profit) }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Average Loss</div>
            <div class="kpi-value loss">₹{{ "{:,.2f}".format(metrics.avg_loss) }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Win %</div>
            <div class="kpi-value">{{ "{:.1f}%".format(metrics.win_rate * 100) }}</div>
        </div>
    </div>

    <!-- Advanced Metrics Table -->
    <table class="data-table">
        <thead>
            <tr>
                <th>Advanced Ratio / Metric</th>
                <th class="text-right">Value</th>
                <th>Standard Definition &amp; Benchmark Context</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="font-bold">CAGR (Compound Annual Growth Rate)</td>
                <td class="text-right font-mono font-bold {{ 'profit-text' if metrics.cagr >= 0 else 'loss-text' }}">
                    {{ "{:+.2f}%".format(metrics.cagr * 100) }}
                </td>
                <td>Annualized geometric return rate across simulation calendar window</td>
            </tr>
            <tr>
                <td class="font-bold">Sharpe Ratio</td>
                <td class="text-right font-mono font-bold">{{ "{:.2f}".format(metrics.sharpe_ratio) }}</td>
                <td>Annualized excess return per unit of volatility (risk-free rate = 0%)</td>
            </tr>
            <tr>
                <td class="font-bold">Sortino Ratio</td>
                <td class="text-right font-mono font-bold">{{ "{:.2f}".format(metrics.sortino_ratio) }}</td>
                <td>Annualized return per unit of downside deviation (minimum acceptable return = 0%)</td>
            </tr>
            <tr>
                <td class="font-bold">Max Drawdown</td>
                <td class="text-right font-mono font-bold loss-text">
                    {{ "{:.2f}%".format(metrics.max_drawdown_pct * 100) }} (₹{{ "{:,.2f}".format(metrics.max_drawdown_amount) }})
                </td>
                <td>Maximum peak-to-trough equity reduction experienced during backtest</td>
            </tr>
            <tr>
                <td class="font-bold">Calmar Ratio</td>
                <td class="text-right font-mono font-bold">{{ "{:.2f}".format(metrics.calmar_ratio) }}</td>
                <td>Ratio of CAGR to Maximum Drawdown (absolute percentage)</td>
            </tr>
            <tr>
                <td class="font-bold">Profit Factor</td>
                <td class="text-right font-mono font-bold">{{ "{:.2f}".format(metrics.profit_factor) }}</td>
                <td>Gross absolute profits divided by gross absolute losses</td>
            </tr>
            <tr>
                <td class="font-bold">Expectancy</td>
                <td class="text-right font-mono font-bold {{ 'profit-text' if metrics.expectancy >= 0 else 'loss-text' }}">
                    ₹{{ "{:,.2f}".format(metrics.expectancy) }}
                </td>
                <td>Average monetary gain/loss expected per executed round-trip trade</td>
            </tr>
            <tr>
                <td class="font-bold">Avg Days Held</td>
                <td class="text-right font-mono font-bold">{{ "{:.1f}".format(metrics.avg_days_held) }} days</td>
                <td>Average holding duration from session T+1 execution to trade exit</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- SECTION 3: CONFIGURATION & PROVENANCE -->
<div class="page-break">
    <div class="section-header">
        <h2 class="section-title">Strategy Configuration</h2>
        <span class="section-subtitle">Execution Parameters &amp; Reproducibility Fingerprint</span>
    </div>

    <table class="config-table">
        <thead>
            <tr>
                <th>Configuration Parameter</th>
                <th>Serialized Value</th>
            </tr>
        </thead>
        <tbody>
            {% for key, val in config_items %}
            <tr>
                <td class="label-col">{{ key }}</td>
                <td class="value-col">{{ val }}</td>
            </tr>
            {% endfor %}
            <tr>
                <td class="label-col font-bold">Data Snapshot Hash</td>
                <td class="value-col font-mono">{{ audit.data_hash }}</td>
            </tr>
            <tr>
                <td class="label-col font-bold">Git Commit SHA</td>
                <td class="value-col font-mono">{{ audit.git_sha }}</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- SECTION 4: PERFORMANCE CHARTS -->
<div class="page-break">
    <div class="section-header">
        <h2 class="section-title">Performance Analytics &amp; Drawdown</h2>
        <span class="section-subtitle">Mark-to-Market Equity Progression &amp; Underwater Curves</span>
    </div>

    <div class="chart-container">
        <img src="{{ equity_chart_path }}" alt="Equity Curve" class="chart-img" />
    </div>

    <div class="chart-container">
        <img src="{{ drawdown_chart_path }}" alt="Drawdown Curve" class="chart-img" />
    </div>
</div>

<div class="page-break">
    <div class="section-header">
        <h2 class="section-title">Monthly Compounded Returns Matrix</h2>
        <span class="section-subtitle">Month x Year Compounded Return Distribution</span>
    </div>

    <div class="chart-container">
        <img src="{{ heatmap_chart_path }}" alt="Monthly Heatmap" class="chart-img" />
    </div>
</div>

<!-- SECTION 5: TRADE LOG -->
<div class="page-break">
    <div class="section-header">
        <h2 class="section-title">Trade Log</h2>
        <span class="section-subtitle">Closed Round-Trip Transactions Ledger ({{ trades_count }} trades)</span>
    </div>

    {% if trades_truncated %}
    <p style="font-size: 8pt; color: #b45309; background-color: #fef3c7; border: 1px solid #fde68a; padding: 6px 10px; border-radius: 4px; margin-bottom: 12px;">
        <strong>Note:</strong> Trade log capped at 5,000 rows in this PDF report. Full trade log available via CSV export.
    </p>
    {% endif %}

    <table class="data-table">
        <thead>
            <tr>
                <th>Symbol</th>
                <th>Entry Date</th>
                <th class="text-right">Entry Price</th>
                <th class="text-right">Qty</th>
                <th>Exit Date</th>
                <th class="text-right">Exit Price</th>
                <th class="text-right">P&amp;L (INR)</th>
                <th class="text-right">P&amp;L (%)</th>
                <th class="text-center">Days</th>
                <th>Exit Reason</th>
            </tr>
        </thead>
        <tbody>
            {% for t in trades_rows %}
            <tr>
                <td class="font-bold">{{ t.symbol }}</td>
                <td class="font-mono">{{ t.entry_date }}</td>
                <td class="text-right font-mono">₹{{ "{:,.2f}".format(t.entry_price) }}</td>
                <td class="text-right font-mono">{{ t.qty }}</td>
                <td class="font-mono">{{ t.exit_date }}</td>
                <td class="text-right font-mono">₹{{ "{:,.2f}".format(t.exit_price) }}</td>
                <td class="text-right font-mono {{ 'profit-text' if t.pnl >= 0 else 'loss-text' }}">
                    {{ "{:+,.2f}".format(t.pnl) }}
                </td>
                <td class="text-right font-mono {{ 'profit-text' if t.pnl_pct >= 0 else 'loss-text' }}">
                    {{ "{:+.2f}%".format(t.pnl_pct * 100) }}
                </td>
                <td class="text-center font-mono">{{ t.days_held }}</td>
                <td>
                    <span class="badge {{ 'badge-success' if t.pnl >= 0 else '' }}">{{ t.exit_reason }}</span>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="10" class="text-center" style="padding: 16px; color: #94a3b8;">
                    No closed trades recorded during backtest simulation.
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- SECTION 6: APPENDIX (ASSUMPTIONS & AUDIT PANEL) -->
<div>
    <div class="section-header">
        <h2 class="section-title">Appendix: Methodology Assumptions &amp; Audit Trail</h2>
        <span class="section-subtitle">Traceability Specifications &amp; Environment Governance</span>
    </div>

    <!-- Audit Provenance Panel -->
    <div class="audit-panel avoid-break">
        <div style="font-weight: 700; font-size: 8.5pt; color: #0f172a; margin-bottom: 8px;">
            Provenance &amp; Reproducibility Audit Record
        </div>
        <div class="audit-grid">
            <div class="audit-item">
                <span class="audit-label">Git Commit SHA</span>
                <span class="audit-val">{{ audit.git_sha }}</span>
            </div>
            <div class="audit-item">
                <span class="audit-label">Data Snapshot Hash (SHA-256)</span>
                <span class="audit-val">{{ audit.data_hash }}</span>
            </div>
            <div class="audit-item">
                <span class="audit-label">Strategy Config Hash (SHA-256)</span>
                <span class="audit-val">{{ config_hash }}</span>
            </div>
            <div class="audit-item">
                <span class="audit-label">Runtime Environment</span>
                <span class="audit-val">Python {{ audit.versions.python }}, FastAPI {{ audit.versions.fastapi }}, Pandas {{ audit.versions.pandas }}</span>
            </div>
        </div>
    </div>

    <!-- Rendered ASSUMPTIONS.md HTML -->
    <div class="appendix-content">
        {{ assumptions_html | safe }}
    </div>
</div>

</body>
</html>
