{
  "openapi": "3.1.0",
  "info": {
    "title": "EquiTest NSE Backtesting API",
    "description": "Quantitative backtesting framework backend for Indian equities",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Service Health Check",
        "description": "Returns service operational status and version",
        "operationId": "root_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "API v1 Health Check",
        "description": "Returns the current operational status and version of the API.",
        "operationId": "api_v1_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/data/ingest": {
      "post": {
        "tags": [
          "data"
        ],
        "summary": "Ingest Market Data",
        "description": "Ingests historical OHLCV data for equities and universe.",
        "operationId": "api_ingest_data_api_v1_data_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/data/coverage": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Get Data Coverage",
        "description": "Returns stored date ranges and session counts for symbols.",
        "operationId": "api_get_coverage_api_v1_data_coverage_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoverageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/universe": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Get Universe Constituents",
        "description": "Returns tickers ranked 101 to 750 with survivorship bias flag.",
        "operationId": "api_get_universe_api_v1_universe_get",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Target date in YYYY-MM-DD format. Defaults to UTC today.",
              "examples": [
                "2023-01-01"
              ],
              "title": "Date"
            },
            "description": "Target date in YYYY-MM-DD format. Defaults to UTC today."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UniverseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/prices/{symbol}": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Get Symbol Prices",
        "description": "Returns historical OHLCV prices for symbol, filtered chronologically.",
        "operationId": "api_get_prices_api_v1_prices__symbol__get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional start date (YYYY-MM-DD)",
              "title": "Start"
            },
            "description": "Optional start date (YYYY-MM-DD)"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional end date (YYYY-MM-DD)",
              "title": "End"
            },
            "description": "Optional end date (YYYY-MM-DD)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/indicators/nifty": {
      "get": {
        "tags": [
          "indicators"
        ],
        "summary": "Get NIFTY Benchmark Indicators",
        "description": "Returns NIFTY benchmark index OHLCV with EMAs (default 50 and 200).",
        "operationId": "api_get_nifty_indicators_api_v1_indicators_nifty_get",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional start date (YYYY-MM-DD)",
              "title": "Start"
            },
            "description": "Optional start date (YYYY-MM-DD)"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional end date (YYYY-MM-DD)",
              "title": "End"
            },
            "description": "Optional end date (YYYY-MM-DD)"
          },
          {
            "name": "spans",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated list of EMA spans",
              "examples": [
                "50,200"
              ],
              "default": "50,200",
              "title": "Spans"
            },
            "description": "Comma-separated list of EMA spans"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndicatorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/indicators/{symbol}": {
      "get": {
        "tags": [
          "indicators"
        ],
        "summary": "Get Symbol Technical Indicators",
        "description": "Returns historical OHLCV augmented with EMAs (20, 50, 150, 200) and 52W high.",
        "operationId": "api_get_symbol_indicators_api_v1_indicators__symbol__get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional start date (YYYY-MM-DD)",
              "title": "Start"
            },
            "description": "Optional start date (YYYY-MM-DD)"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional end date (YYYY-MM-DD)",
              "title": "End"
            },
            "description": "Optional end date (YYYY-MM-DD)"
          },
          {
            "name": "spans",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated list of EMA spans",
              "examples": [
                "20,50,150,200"
              ],
              "default": "20,50,150,200",
              "title": "Spans"
            },
            "description": "Comma-separated list of EMA spans"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndicatorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/indicators/preview": {
      "post": {
        "tags": [
          "indicators"
        ],
        "summary": "Preview Custom Indicators",
        "description": "Calculates custom indicators dynamically with given configuration.",
        "operationId": "api_preview_indicators_api_v1_indicators_preview_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndicatorPreviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndicatorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/signals/screen": {
      "get": {
        "tags": [
          "signals"
        ],
        "summary": "Screen Universe for Entry Signals",
        "description": "Returns point-in-time universe constituent symbols with an active entry signal on the given date (REQ-3.4).",
        "operationId": "api_screen_signals_api_v1_signals_screen_get",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Target evaluation date in YYYY-MM-DD format",
              "examples": [
                "2020-06-25"
              ],
              "title": "Date"
            },
            "description": "Target evaluation date in YYYY-MM-DD format"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScreenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/signals/{symbol}": {
      "get": {
        "tags": [
          "signals"
        ],
        "summary": "Get Symbol Trading Signals",
        "description": "Returns chronological series of OHLCV bars with technical indicators, filters, and entry/exit signal evaluations (REQ-3.4, REQ-3.5).",
        "operationId": "api_get_symbol_signals_api_v1_signals__symbol__get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional start date (YYYY-MM-DD)",
              "title": "Start"
            },
            "description": "Optional start date (YYYY-MM-DD)"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional end date (YYYY-MM-DD)",
              "title": "End"
            },
            "description": "Optional end date (YYYY-MM-DD)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CoverageItem": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "description": "Equity or index ticker symbol"
          },
          "first_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Date",
            "description": "Earliest available trading session"
          },
          "last_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Date",
            "description": "Latest available trading session"
          },
          "rows": {
            "type": "integer",
            "title": "Rows",
            "description": "Total number of stored trading sessions"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "rows"
        ],
        "title": "CoverageItem"
      },
      "CoverageResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CoverageItem"
            },
            "type": "array",
            "title": "Items",
            "description": "List of symbol coverage summaries"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CoverageResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Operational status of the service",
            "default": "ok",
            "examples": [
              "ok"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Semantic application version",
            "default": "0.1.0",
            "examples": [
              "0.1.0"
            ]
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "IndicatorConfigSchema": {
        "properties": {
          "spans": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Spans",
            "description": "EMA spans to compute (e.g. [20, 50, 150, 200])",
            "default": [
              20,
              50,
              150,
              200
            ],
            "examples": [
              [
                20,
                50,
                150,
                200
              ]
            ]
          },
          "include_high_52w": {
            "type": "boolean",
            "title": "Include High 52W",
            "description": "Whether to compute rolling 52-week high",
            "default": true
          },
          "high_52w_lookback": {
            "type": "integer",
            "title": "High 52W Lookback",
            "description": "Lookback window sessions for 52W high calculation",
            "default": 252,
            "examples": [
              252
            ]
          }
        },
        "type": "object",
        "title": "IndicatorConfigSchema"
      },
      "IndicatorItem": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date",
            "description": "Session date (YYYY-MM-DD)"
          },
          "open": {
            "type": "number",
            "title": "Open",
            "description": "Opening price"
          },
          "high": {
            "type": "number",
            "title": "High",
            "description": "Highest price during session"
          },
          "low": {
            "type": "number",
            "title": "Low",
            "description": "Lowest price during session"
          },
          "close": {
            "type": "number",
            "title": "Close",
            "description": "Unadjusted closing price"
          },
          "adj_close": {
            "type": "number",
            "title": "Adj Close",
            "description": "Corporate-action adjusted closing price"
          },
          "volume": {
            "type": "number",
            "title": "Volume",
            "description": "Total trading volume"
          },
          "ema_20": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ema 20",
            "description": "20-day EMA"
          },
          "ema_50": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ema 50",
            "description": "50-day EMA"
          },
          "ema_150": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ema 150",
            "description": "150-day EMA"
          },
          "ema_200": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ema 200",
            "description": "200-day EMA"
          },
          "high_52w": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "High 52W",
            "description": "52-week rolling high"
          },
          "indicators": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Indicators",
            "description": "Dictionary of dynamic or custom computed indicator values"
          }
        },
        "type": "object",
        "required": [
          "date",
          "open",
          "high",
          "low",
          "close",
          "adj_close",
          "volume"
        ],
        "title": "IndicatorItem"
      },
      "IndicatorPreviewRequest": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "description": "Symbol to compute preview indicators for",
            "default": "RELIANCE",
            "examples": [
              "RELIANCE"
            ]
          },
          "start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start",
            "description": "Optional start date (YYYY-MM-DD)",
            "examples": [
              "2020-01-01"
            ]
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End",
            "description": "Optional end date (YYYY-MM-DD)",
            "examples": [
              "2023-12-31"
            ]
          },
          "config": {
            "$ref": "#/components/schemas/IndicatorConfigSchema",
            "description": "Indicator calculation configuration"
          }
        },
        "type": "object",
        "title": "IndicatorPreviewRequest"
      },
      "IndicatorResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "description": "Equity or benchmark ticker symbol"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Number of indicator bars returned"
          },
          "indicators": {
            "items": {
              "$ref": "#/components/schemas/IndicatorItem"
            },
            "type": "array",
            "title": "Indicators",
            "description": "Chronological series of indicator-augmented OHLCV bars"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "count",
          "indicators"
        ],
        "title": "IndicatorResponse"
      },
      "IngestRequest": {
        "properties": {
          "start": {
            "type": "string",
            "title": "Start",
            "description": "Start date for data ingestion in YYYY-MM-DD format",
            "examples": [
              "2020-01-01"
            ]
          },
          "end": {
            "type": "string",
            "title": "End",
            "description": "End date for data ingestion in YYYY-MM-DD format",
            "examples": [
              "2024-01-01"
            ]
          },
          "symbols": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbols",
            "description": "Optional list of ticker symbols. Defaults to active universe.",
            "examples": [
              [
                "RELIANCE",
                "HDFCBANK",
                "INFY"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "IngestRequest"
      },
      "IngestResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "Unique ingestion job execution ID"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Job execution status (completed, partial, failed)"
          },
          "symbols_ingested": {
            "type": "integer",
            "title": "Symbols Ingested",
            "description": "Number of symbols successfully processed"
          },
          "rows_ingested": {
            "type": "integer",
            "title": "Rows Ingested",
            "description": "Total new price rows inserted into database"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors",
            "description": "List of non-fatal ingestion warnings or errors",
            "default": []
          }
        },
        "type": "object",
        "required": [
